local function rememberSlotOne(tool)
    if tool and tool:IsA("Tool") then
        slotOneTool = tool
    end
end

local function captureSlotOne()
    if slotOneTool and slotOneTool.Parent then
        return slotOneTool
    end
    local char = localPlayer.Character
    local equipped = char and char:FindFirstChildOfClass("Tool")
    local pack = localPlayer:FindFirstChild("Backpack")
    -- 손에 든 게 없고 가방 첫 도구면 그게 1번
    if not equipped and pack then
        for _, child in ipairs(pack:GetChildren()) do
            if child:IsA("Tool") then
                rememberSlotOne(child)
                return child
            end
        end
    end
    rememberSlotOne(equipped)
    return equipped
end

local function identifySlotOne()
    task.spawn(function()
        VIM:SendKeyEvent(true, Enum.KeyCode.One, false, game)
        task.wait(0.05)
        VIM:SendKeyEvent(false, Enum.KeyCode.One, false, game)
        task.wait(0.08)
        local char = localPlayer.Character
        rememberSlotOne(char and char:FindFirstChildOfClass("Tool"))
    end)
end

local function isHoldingSlotOne()
    local char = localPlayer.Character
    if not char then return false end
    local equipped = char:FindFirstChildOfClass("Tool")
    if not equipped then return false end
    if not slotOneTool or not slotOneTool.Parent then
        captureSlotOne()
    end
    return slotOneTool ~= nil and equipped == slotOneTool
end

local function pressZ()
    local now = tick()
    if now - lastZPressAt < Z_PRESS_COOLDOWN then return end
    lastZPressAt = now
    task.spawn(function()
        pcall(function()
            VIM:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
            task.wait(0.04)
            VIM:SendKeyEvent(false, Enum.KeyCode.Z, false, game)
        end)
    end)
end

local function onHealthDropped(newHealth)
    if not isDamageZOn then return end
    if type(newHealth) ~= "number" then return end
    if newHealth <= 0 then return end
    if not isHoldingSlotOne() then return end
    pressZ()
end

local healthConn
local function bindDamageZ(character)
    if healthConn then
        healthConn:Disconnect()
        healthConn = nil
    end
    lastKnownHealth = nil
    if not character then return end
    task.spawn(function()
        local humanoid = character:WaitForChild("Humanoid", 8)
        if not humanoid then return end
        lastKnownHealth = humanoid.Health
        captureSlotOne()
        healthConn = humanoid.HealthChanged:Connect(function(hp)
            local prev = lastKnownHealth
            lastKnownHealth = hp
            if prev and hp < prev - 0.05 then
                onHealthDropped(hp)
            end
        end)
    end)
end

localPlayer.CharacterAdded:Connect(function(character)
    slotOneTool = nil
    lastKnownHealth = nil
    bindDamageZ(character)
end)
if localPlayer.Character then
    bindDamageZ(localPlayer.Character)
end

local function calculateRelativeLeadPosition(targetPos, targetVelocity, myPos, myVelocity, bulletSpeed)
    local distance        = (targetPos - myPos).Magnitude
    local totalTime       = (distance / bulletSpeed) + chargingDelay
    local blendedVelocity = targetVelocity - (myVelocity * myVelocityWeight)
    local moveDirection   = blendedVelocity.Magnitude > 0.1
        and blendedVelocity.Unit or Vector3.new(0, 0, 0)
    local leadVector      = (blendedVelocity * totalTime * leadMultiplier)
        + (moveDirection * extraFrontOffset)
    return targetPos + leadVector
end

