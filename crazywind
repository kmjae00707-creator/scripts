    pcall(function()
        request({
            Url     = SERVER_URL .. "/notify",
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = HttpService:JSONEncode({
                modelName  = modelName,
                sign       = getSignText(),
                luck       = getLuckText(),
                time       = os.date("%Y-%m-%d %H:%M:%S UTC", os.time()),
                serverLink = (serverLinkValue ~= "" and serverLinkValue) or nil,
            }),
        })
    end)
end

