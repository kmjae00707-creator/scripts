local function setPopUpOptions(popup, names)
    if not popup then return end
    pcall(function()
        local opts = popup.Options
        if type(opts) == "table" then
            for i = #opts, 1, -1 do
                pcall(function() popup:Remove(i) end)
            end
        end
        for _, name in ipairs(names) do
            popup:Option(name)
        end
    end)
end

local function getVipSpawnRemote()
    local pg = localPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local ok, ev = pcall(function()
        return pg.VIPGUI.VipMenuFrame.Server.CantSpawn.TextButton.RemoteEvent
    end)
    return ok and ev or nil
end

local function fireSetrairty(value)
    local num = tonumber(value)
    if not num then return false end
    local ev = getVipSpawnRemote()
    if not ev then return false end
    return pcall(function()
        ev:FireServer(num)
    end)
end

local function submitSetrairty(rawText)
    local text = tostring(rawText or ""):gsub("%D", "")
    if text == "" then return end
    local num = tonumber(text)
    if not num then return end
    setrairtyValue = num
    fireSetrairty(num)
    scheduleSaveConfig()
end

local function submitServerLink(rawText)
    local link = tostring(rawText or ""):match("^%s*(.-)%s*$") or ""
    serverLinkValue = link
    scheduleSaveConfig()
end

local function refreshBlockList()
    local activeNames, mutedNames = {}, {}
    for _, name in ipairs(seenModels) do
        if blockedNames[name] == true then
            table.insert(mutedNames, name)
        else
            table.insert(activeNames, name)
        end
    end
    setPopUpOptions(activePopUp, activeNames)
    setPopUpOptions(mutedPopUp, mutedNames)
end

local function trackModelName(name)
    for _, v in ipairs(seenModels) do
        if v == name then return end
    end
    table.insert(seenModels, name)
    refreshBlockList()
    scheduleSaveConfig()
end

